{
  "name": "@dev.fast/diffr",
  "version": "0.1.3",
  "description": "diffr's NDJSON wire contract, validators, and release binary fetcher",
  "repository": "https://github.com/devdotfast/diffr",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json",
    "./src/*": "./src/*"
  },
  "bin": {
    "diffr-fetch": "bin/fetch.mjs"
  },
  "files": [
    "dist",
    "src",
    "!src/*.test.ts",
    "!src/test-binary.ts",
    "bin",
    "pins.json",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "pin": "node scripts/pin.mjs",
    "prepack": "npm run build"
  },
  "peerDependencies": {
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/bun": "1.3.10",
    "typescript": "5.9.3",
    "zod": "4.1.12"
  },
  "engines": {
    "node": ">=20"
  }
}
