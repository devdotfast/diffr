{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": [
      "ES2023",
      "DOM",
      "DOM.Iterable",
      "WebWorker"
    ],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": false,
    "types": [],
    "paths": {
      "zod": [
        "./node_modules/zod"
      ],
      "string-width": [
        "./node_modules/string-width"
      ],
      "get-east-asian-width": [
        "./node_modules/get-east-asian-width"
      ]
    }
  },
  "include": [
    "src"
  ]
}
