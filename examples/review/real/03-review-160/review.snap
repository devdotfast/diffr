--- a/packages/progressive-review/src/opencode-trace-export.ts
+++ b/packages/progressive-review/src/opencode-trace-export.ts
        1 + import { spawn } from "node:child_process";
        2 + import {
        3 +   closeSync,
        4 +   mkdirSync,
        5 +   openSync,
        6 +   readFileSync,
        7 +   renameSync,
        8 +   rmSync,
        9 +   writeFileSync,
       10 + } from "node:fs";
       11 + import path from "node:path";
       12 + 
       13 + import {
       14 +   type JsonObject,
       15 +   type JsonValue,
       16 +   jsonArray,
       17 +   jsonObject,
       18 +   parseJsonText,
       19 + } from "@dev.fast/review-protocol";
       20 + 
       21 + export const OPENCODE_SESSION_RECORD = "opencode_session";
       22 + export const OPENCODE_MESSAGE_RECORD = "opencode_message";
       23 + 
       24 + /** OpenCode session ids are `ses_` followed by a sortable id. */
       25 + export function isOpenCodeSessionId(sessionId: string): boolean {
       26 +   return sessionId.startsWith("ses_");
       27 + }
       28 + 
       29 + /**
       30 +  * OpenCode keeps sessions in its own database rather than a transcript file.
       31 +  * `opencode export` renders one as JSON; this writes that as the JSONL trace
       32 +  * the rest of the pipeline expects: one session header record, then one
       33 +  * record per message with its parts stripped of provider metadata and inline
       34 +  * file data. Returns null when OpenCode has no such session.
       35 +  */
       36 + export async function exportOpenCodeTrace(input: {
       37 +   sessionId: string;
       38 +   root: string;
       39 + }): Promise<string | null> {
       40 +   mkdirSync(input.root, { recursive: true });
       41 +   const destination = path.join(input.root, `${input.sessionId}.jsonl`);
       42 +   const staging = `${destination}.tmp-${process.pid}`;
       43 +   const raw = await runOpenCodeExport(input.sessionId, `${staging}.json`);
       44 +   if (raw === null) return null;
       45 +   const exported = jsonObject(parseJsonText(raw));
       46 +   const info = jsonObject(exported?.info);
       47 +   if (!exported || !info) {
       48 +     throw new Error(
       49 +       `opencode export ${input.sessionId} returned no session info.`,
       50 +     );
       51 +   }
       52 +   const messages = jsonArray(exported.messages);
       53 +   if (!messages) {
       54 +     throw new Error(
       55 +       `opencode export ${input.sessionId} returned no message list.`,
       56 +     );
       57 +   }
       58 +   const header: JsonObject = {
       59 +     type: OPENCODE_SESSION_RECORD,
       60 +     ...pick(info, ["id", "parentID", "directory", "title", "version", "time"]),
       61 +   };
       62 +   const lines = [
       63 +     JSON.stringify(header),
       64 +     ...messages.map((message) => JSON.stringify(traceMessageRecord(message))),
       65 +   ];
       66 +   writeFileSync(staging, `${lines.join("\n")}\n`, "utf8");
       67 +   renameSync(staging, destination);
       68 +   return destination;
       69 + }
       70 + 
       71 + /**
       72 +  * Runs `opencode export` with stdout on a file. OpenCode exits before a pipe
       73 +  * drains, so a piped export is cut off at 128 KiB; a file descriptor is not.
       74 +  * Resolves to the exported JSON, or null when OpenCode has no such session.
       75 +  */
       76 + function runOpenCodeExport(
       77 +   sessionId: string,
       78 +   stdoutPath: string,
       79 + ): Promise<string | null> {
       80 +   const fd = openSync(stdoutPath, "w");
       81 +   return new Promise<string | null>((resolve, reject) => {
       82 +     // `--pure` skips user plugins, so the Review trace plugin cannot fire
       83 +     // hooks from inside the export it triggered.
       84 +     const child = spawn("opencode", ["export", sessionId, "--pure"], {
       85 +       stdio: ["ignore", fd, "pipe"],
       86 +       windowsHide: true,
       87 +     });
       88 +     let stderr = "";
       89 +     const stderrStream = child.stderr;
       90 +     if (!stderrStream) {
       91 +       throw new Error("opencode export did not open a stderr pipe.");
       92 +     }
       93 +     stderrStream.setEncoding("utf8");
       94 +     stderrStream.on("data", (chunk: string) => {
       95 +       stderr += chunk;
       96 +     });
       97 +     child.once("error", (error) => {
       98 +       closeSync(fd);
       99 +       rmSync(stdoutPath, { force: true });
      100 +       reject(
      101 +         new Error(`opencode export ${sessionId} failed: ${error.message}`),
      102 +       );
      103 +     });
      104 +     child.once("exit", (code) => {
      105 +       closeSync(fd);
      106 +       try {
      107 +         if (code === 0) {
      108 +           resolve(readFileSync(stdoutPath, "utf8"));
      109 +         } else if (stderr.includes("Session not found")) {
      110 +           resolve(null);
      111 +         } else {
      112 +           reject(
      113 +             new Error(
      114 +               `opencode export ${sessionId} exited with ${code}: ${stderr.trim()}`,
      115 +             ),
      116 +           );
      117 +         }
      118 +       } finally {
      119 +         rmSync(stdoutPath, { force: true });
      120 +       }
      121 +     });
      122 +   });
      123 + }
      124 + 
      125 + function traceMessageRecord(message: JsonValue) {
      126 +   const record = jsonObject(message);
      127 +   const info = jsonObject(record?.info);
      128 +   if (!record || !info) {
      129 +     throw new Error("opencode export returned a message without info.");
      130 +   }
      131 +   const parts = jsonArray(record.parts) ?? [];
      132 +   const trace: JsonObject = {
      133 +     type: OPENCODE_MESSAGE_RECORD,
      134 +     info: pick(info, [
      135 +       "id",
      136 +       "sessionID",
      137 +       "role",
      138 +       "time",
      139 +       "error",
      140 +       "agent",
      141 +       "modelID",
      142 +       "providerID",
      143 +     ]),
      144 +     parts: parts.flatMap((part) => {
      145 +       const object = jsonObject(part);
      146 +       return object ? [tracePart(object)] : [];
      147 +     }),
      148 +   };
      149 +   return trace;
      150 + }
      151 + 
      152 + function tracePart(part: JsonObject) {
      153 +   const common = pick(part, ["id", "type"]);
      154 +   switch (part.type) {
      155 +     case "text":
      156 +       return { ...common, ...pick(part, ["text", "ignored", "synthetic"]) };
      157 +     case "reasoning":
      158 +       return { ...common, ...pick(part, ["text", "time"]) };
      159 +     case "tool": {
      160 +       const state = jsonObject(part.state);
      161 +       return {
      162 +         ...common,
      163 +         ...pick(part, ["tool", "callID"]),
      164 +         state: state
      165 +           ? pick(state, ["status", "input", "output", "error", "title", "time"])
      166 +           : {},
      167 +       };
      168 +     }
      169 +     case "file":
      170 +       return { ...common, ...pick(part, ["mime", "filename"]) };
      171 +     case "patch":
      172 +       return { ...common, ...pick(part, ["hash", "files"]) };
      173 +     case "compaction":
      174 +       return { ...common, ...pick(part, ["auto"]) };
      175 +     default:
      176 +       return common;
      177 +   }
      178 + }
      179 + 
      180 + function pick(value: JsonObject, keys: readonly string[]) {
      181 +   const picked: JsonObject = {};
      182 +   for (const key of keys) {
      183 +     const entry = value[key];
      184 +     if (entry !== undefined) picked[key] = entry;
      185 +   }
      186 +   return picked;
      187 + }
