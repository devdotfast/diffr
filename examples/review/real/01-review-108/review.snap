      958 + /** Merged view for consumers that need both halves. Re-renders on state changes. */
      959 + export function useReview(): ReviewContextValue {
      960 +   const actions = useReviewActions();
      961 +   const state = useReviewState();
      962 +   return useMemo(() => ({ ...actions, ...state }), [actions, state]);
